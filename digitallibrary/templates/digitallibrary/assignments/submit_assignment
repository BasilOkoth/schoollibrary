{% extends "digitallibrary/base.html" %}
{% block title %}Submit Assignment{% endblock %}
{% block content %}
<div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-white mb-2">Submit Assignment</h1>
    <p class="text-gray-400 mb-6">Upload your completed work.</p>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-5 mb-6">
        <h2 class="text-lg font-bold text-white">{{ resource.title }}</h2>
        <p class="text-gray-400 text-sm mt-1">Student: {{ student.first_name }} {{ student.last_name }} - {{ student.admission_number }}</p>
        {% if resource.subject %}<p class="text-gray-400 text-sm mt-1">Subject: {{ resource.subject }}</p>{% endif %}
        {% if resource.due_date %}<p class="text-yellow-400 text-sm mt-1">Due: {{ resource.due_date|date:"M d, Y H:i" }}</p>{% endif %}
        {% if resource.file %}<a href="{{ resource.file.url }}" target="_blank" class="inline-block mt-3 text-blue-400 hover:text-blue-300">Download Assignment File</a>{% endif %}
    </div>

    <form method="post" enctype="multipart/form-data" class="bg-gray-800 rounded-xl border border-gray-700 p-5">
        {% csrf_token %}
        <div class="mb-4"><label class="block text-sm text-gray-300 mb-1">Upload Completed Work</label>{{ form.submitted_file }}</div>
        <div class="mb-4"><label class="block text-sm text-gray-300 mb-1">Note to Teacher</label>{{ form.student_note }}</div>
        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-lg font-semibold">Submit Assignment</button>
    </form>
</div>
{% endblock %}
